# Copia questo file in `.env` e sostituisci i valori con le tue credenziali.
# Il file `.env` è ignorato da git (vedi .gitignore) e NON va mai committato.

# API key di OpenRouter (https://openrouter.ai/) — usata dall'agent LangChain
OPENROUTER_API_KEY=<la-tua-api-key-openrouter>

# Modello LLM da utilizzare tramite OpenRouter (es. nvidia/nemotron-3-nano-30b-a3b:free)
OPENROUTER_MODEL_NAME=<scegli-il-modello>